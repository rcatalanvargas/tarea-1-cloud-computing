{
  "problem_type": "binary_classification",
  "target": "Placement_Status",
  "positive_class": "Placed",
  "classes": [
    "Not Placed",
    "Placed"
  ],
  "input_features": [
    "Age",
    "Gender",
    "University_Year",
    "Major",
    "Attendance_Percentage",
    "Study_Hours_Per_Week",
    "CGPA",
    "Programming_Skill",
    "Projects_Completed",
    "Certifications",
    "Hackathons",
    "GitHub_Profile",
    "Internships",
    "Leadership_Experience",
    "LinkedIn_Profile",
    "Resume_Score",
    "Communication_Skills",
    "Teamwork",
    "Problem_Solving",
    "English_Proficiency",
    "Interview_Score"
  ],
  "numeric_features": [
    "Age",
    "Attendance_Percentage",
    "Study_Hours_Per_Week",
    "CGPA",
    "Programming_Skill",
    "Projects_Completed",
    "Certifications",
    "Hackathons",
    "Internships",
    "Resume_Score",
    "Communication_Skills",
    "Teamwork",
    "Problem_Solving",
    "Interview_Score"
  ],
  "categorical_features": [
    "Gender",
    "University_Year",
    "Major",
    "GitHub_Profile",
    "Leadership_Experience",
    "LinkedIn_Profile",
    "English_Proficiency"
  ],
  "excluded_features": [
    "Student_ID",
    "Academic_Performance",
    "Company_Tier",
    "Career_Field",
    "Placement_Mode",
    "Starting_Salary_USD",
    "Employability_Score"
  ],
  "dataset_rows": 50000,
  "training_rows": 40000,
  "test_rows": 10000,
  "data_split": {
    "test_size": 0.2,
    "random_state": 42,
    "stratified": true
  },
  "cross_validation": {
    "method": "StratifiedKFold",
    "n_splits": 5,
    "shuffle": true,
    "random_state": 42
  },
  "estimator": {
    "name": "LogisticRegression",
    "max_iter": 1000,
    "class_weight": "balanced",
    "random_state": 42
  },
  "metrics": {
    "cross_validation": {
      "accuracy": {
        "media": 0.7485,
        "desviacion_estandar": 0.0046
      },
      "balanced_accuracy": {
        "media": 0.738,
        "desviacion_estandar": 0.0068
      },
      "f1_macro": {
        "media": 0.6904,
        "desviacion_estandar": 0.0056
      },
      "roc_auc": {
        "media": 0.8114,
        "desviacion_estandar": 0.0046
      }
    },
    "test": {
      "accuracy": 0.7414,
      "balanced_accuracy": 0.7296,
      "f1_macro": 0.6825,
      "roc_auc": 0.8031
    }
  },
  "versions": {
    "python": "3.12.12",
    "numpy": "2.1.3",
    "pandas": "2.2.3",
    "scipy": "1.14.1",
    "scikit-learn": "1.5.2",
    "joblib": "1.4.2"
  }
}